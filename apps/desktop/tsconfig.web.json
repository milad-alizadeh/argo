{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Only the `bun:test` module for the renderer tests: no Bun globals reach the renderer.
    "types": ["bun-types/test"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/mocks/*": ["./mocks/*"],
      "@/*": ["./src/*"],
      "cn": ["./src/platform/renderer/lib/utils.ts"]
    }
  },
  "include": [
    "src/domains/*/contract/**/*.ts",
    "src/domains/*/renderer/**/*.ts",
    "src/domains/*/renderer/**/*.tsx",
    "src/platform/contract/**/*.ts",
    "src/platform/renderer/**/*.ts",
    "src/platform/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "src/harnesses/harness.ts",
    "src/harnesses/harness-presentation.ts",
    "src/harnesses/presentation-registry.ts",
    "src/harnesses/*/presentation/**/*.ts",
    "src/harnesses/*/presentation/**/*.tsx",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "tests/**/*.ts",
    "mocks/sessions/session-story-host.ts",
    "mocks/sessions/session-selection-host.fixture.ts",
    "mocks/tickets/renderer-models.ts",
    "mocks/platform/story-preload.ts",
    "mocks/sessions/session-rows.ts",
    "mocks/tickets/scenario.test.ts",
    "mocks/platform/trpc-transport.test.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "src/platform/contract/**/*.test.ts",
    // This reads source files through the Bun global, so tsconfig.node.json checks it.
    "src/renderer/catalogs.test.ts"
  ]
}
