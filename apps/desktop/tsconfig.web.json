{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "cn": ["./src/renderer/lib/utils.ts"]
    }
  },
  "include": [
    "src/domains/*/contract/**/*.ts",
    "src/domains/*/renderer/**/*.ts",
    "src/domains/*/renderer/**/*.tsx",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "src/domains/*/renderer/**/*.test.ts",
    "src/domains/*/renderer/**/*.test.tsx",
    "src/renderer/**/*.test.ts",
    "src/renderer/**/*.test.tsx"
  ]
}
