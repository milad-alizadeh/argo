{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/mocks/*": ["./mocks/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2023"],
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The package-time scripts run under bare `node`, with no build step in front: Node 24 strips
    // their types at run time (#2503). `erasableSyntaxOnly` refuses the TypeScript that carries a
    // runtime meaning — enum, namespace, parameter properties — which is the syntax Node cannot
    // strip. Two of those scripts import main-process source, so the rule covers `src` as well.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  // Renderer tests that read source files through the Bun global; tsconfig.web.json excludes them.
  "files": [
    "src/platform/renderer/styles/typography-contract.test.ts",
    "src/renderer/catalogs.test.ts"
  ],
  "include": [
    "src/**/*.ts",
    "*.config.ts",
    "forge.config.ts",
    "scripts/**/*.mts",
    "tools/**/*.mts"
  ],
  "exclude": [
    "src/renderer",
    "src/platform/renderer",
    "src/domains/*/renderer",
    "tools/desktop/capture.mts",
    "tools/desktop/measure.mts",
    "src/harnesses/harness-presentation.ts",
    "src/harnesses/presentation-registry.ts",
    "src/harnesses/*/presentation",
    "src/harnesses/claude/integration",
    "src/harnesses/codex/integration",
    "src/domains/projects/**/*.test.ts",
    "src/platform/contract/watch.test.ts",
    "src/platform/main/watch/**/*.test.ts",
    "src/platform/main/ipc/every-domain-refuses-untrusted-frames.test.ts",
    "src/domains/sessions/main/projection/reads.test.ts",
    "src/harnesses/codex/sessions/thread-titles.test.ts",
    "src/harnesses/codex/sessions/thread-names.test.ts",
    "src/harnesses/codex/sessions/managed-thread-titles.test.ts",
    "src/harnesses/codex/sessions/thread-title-fixtures.ts"
  ]
}
