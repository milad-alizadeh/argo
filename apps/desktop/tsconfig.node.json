{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The package-time scripts are plain `.mjs` on purpose: Forge's hooks and CI both run them
    // with bare `node`, with no build step in front. `allowJs` lets `forge.config.ts` import
    // them with inferred types instead of `any`; `checkJs` stays off, so they are read, not
    // graded.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "*.config.ts", "forge.config.ts", "scripts/**/*.mjs"],
  "exclude": [
    "src/renderer",
    "src/core/projects/fake-driver",
    "src/core/tickets/fake-driver",
    "src/providers/github/fake-driver",
    "src/providers/linear/fake-driver",
    "src/core/sessions/fake-driver",
    "src/agents/claude/session-fake-driver",
    "src/agents/codex/session-fake-driver",
    "src/core/appearance/**/*.test.ts",
    "src/core/projects/**/*.test.ts",
    "src/core/commands/**/*.test.ts",
    "src/core/contract/every-domain-refuses-untrusted-frames.test.ts",
    "src/agents/codex/sessions/thread-titles.test.ts",
    "src/agents/codex/sessions/thread-names.test.ts",
    "src/agents/codex/sessions/managed-thread-titles.test.ts",
    "src/agents/codex/sessions/thread-title-fixtures.ts"
  ]
}
