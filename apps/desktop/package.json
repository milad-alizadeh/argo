{
  "name": "@argo/desktop",
  "version": "0.1.0",
  "description": "Argo cockpit on Electron. Scaffold under migration; packaged tests are its gate.",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/dev-instance.mts",
    "dev:status": "node scripts/dev-control.mts status",
    "dev:stop": "node scripts/dev-control.mts stop",
    "dev:prove-isolation": "node scripts/prove-dev-instance-isolation.mts",
    "database:generate": "drizzle-kit generate --config drizzle.config.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "storybook": "storybook dev -p 6006",
    "prototype:ticket-layout": "vite --config prototypes/ticket-layout/vite.config.mts",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook-dark --project=storybook-light",
    "build": "electron-forge package --arch arm64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:packaged-contents": "node scripts/assert-packaged-pty.mts",
    "test:packaged-manifest": "bun run desktop:manifest",
    "test:packaged-pty": "node scripts/prove-packaged-pty.mts",
    "test:e2e": "playwright test",
    "test:e2e:profile": "ARGO_E2E_PROFILE=1 playwright test",
    "e2e:real": "ARGO_E2E_REAL=1 playwright test --project=real-sessions",
    "test:live-claude-display": "node tools/run-tool.mts tools/claude/message-display.ts",
    "capture:cockpit": "node tools/run-tool.mts tools/cockpit/capture.ts",
    "measure:cockpit": "node tools/run-tool.mts tools/cockpit/measure.ts",
    "measure:session-open": "node tools/run-tool.mts tools/sessions/open-session-cost.ts",
    "desktop:manifest": "node scripts/desktop-manifest.mts",
    "desktop:verdict": "node scripts/write-release-verdict.mts",
    "test": "bun test && bun run test:node",
    "test:node": "vitest run --project=node"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/text": "^0.39.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/virtual-core": "^3.17.11",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@uiw/codemirror-theme-xcode": "4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "node-addon-api": "7.1.1",
    "node-pty": "1.2.0-beta.15",
    "react-day-picker": "^10.0.1",
    "recharts": "^3.8.0",
    "xstate": "^5",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@lexical/code": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@playwright/test": "^1.63.0",
    "@shadcn/react": "0.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron": "44.2.0",
    "i18next": "^26.4.2",
    "lexical": "^0.39.0",
    "lucide-react": "1.44.0",
    "mermaid": "12.0.0",
    "msw": "^2",
    "playwright-core": "1.63.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-i18next": "^17.0.13",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "react-router": "^7.13.1",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vitest": "^4.0.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "yauzl": "3.3.1",
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "2.1.3"
    }
  },
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
