{
  "name": "@argo/desktop",
  "version": "0.1.0",
  "description": "Argo cockpit on Electron. Scaffold under migration; packaged tests are its gate.",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/link-hoisted-electron.mjs && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook",
    "design:render": "node scripts/render-desktop-state.mjs",
    "build": "bun run test:packaged-pty --arch arm64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.fake-drivers.json",
    "build:fake-drivers": "bun build src/core/projects/fake-driver/prove-project-contract.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=scripts/project-fake-driver/prove-project-contract.mjs && bun build src/core/projects/fake-driver/capture-cockpit.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=scripts/project-fake-driver/capture-cockpit.mjs && bun build src/core/projects/fake-driver/measure-cockpit.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=scripts/project-fake-driver/measure-cockpit.mjs && bun build src/core/sessions/fake-driver/prove-session-feed.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=scripts/session-fake-driver/prove-session-feed.mjs",
    "test:packaged-contents": "node scripts/assert-packaged-pty.mjs",
    "test:packaged-manifest": "bun run desktop:manifest",
    "test:packaged-pty": "node scripts/prove-packaged-pty.mjs",
    "test:packaged-project": "bun run build:fake-drivers && node scripts/project-fake-driver/prove-project-contract.mjs",
    "test:packaged-session": "bun run build:fake-drivers && node scripts/session-fake-driver/prove-session-feed.mjs",
    "capture:cockpit": "bun run build:fake-drivers && node scripts/project-fake-driver/capture-cockpit.mjs",
    "measure:cockpit": "bun run build:fake-drivers && node scripts/project-fake-driver/measure-cockpit.mjs",
    "desktop:manifest": "node scripts/desktop-manifest.mjs",
    "desktop:verdict": "node scripts/write-release-verdict.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "node-addon-api": "7.1.1",
    "node-pty": "1.2.0-beta.15",
    "react-day-picker": "^10.0.1",
    "recharts": "^3.8.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@lexical/react": "^0.39.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@shadcn/react": "0.3.1",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron": "44.2.0",
    "i18next": "^26.4.2",
    "lucide-react": "1.44.0",
    "lexical": "^0.39.0",
    "playwright-core": "1.63.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-i18next": "^17.0.13",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "react-router": "^7.13.1",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vitest": "^4.0.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "yauzl": "3.3.1",
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "2.1.3"
    }
  },
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
