{
  "name": "@argo/desktop",
  "version": "0.1.0",
  "description": "Argo cockpit on Electron. Scaffold under migration; a packaged node-pty acceptance run is its gate.",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node ../../scripts/node-version-gate.mjs && electron-forge start",
    "package": "node ../../scripts/node-version-gate.mjs && electron-forge package",
    "make": "node ../../scripts/node-version-gate.mjs && electron-forge make",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "design:render": "node scripts/render-desktop-state.mjs",
    "release:build": "bun run prove:pty --arch arm64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:session-scripts": "bun build src/scripts/session-proof/prove-project-contract.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=scripts/prove-project-contract.mjs && bun build src/scripts/session-proof/prove-session-feed.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=scripts/prove-session-feed.mjs",
    "prove:pty": "node ../../scripts/node-version-gate.mjs && node scripts/prove-packaged-pty.mjs",
    "prove:project-contract": "node ../../scripts/node-version-gate.mjs && bun run build:session-scripts && node scripts/prove-project-contract.mjs",
    "prove:session": "node ../../scripts/node-version-gate.mjs && bun run build:session-scripts && node scripts/prove-session-feed.mjs",
    "assert:packaged": "node ../../scripts/node-version-gate.mjs && node scripts/assert-packaged-pty.mjs",
    "desktop:manifest": "node ../../scripts/node-version-gate.mjs && node scripts/desktop-manifest.mjs",
    "desktop:verdict": "node ../../scripts/node-version-gate.mjs && node scripts/write-release-verdict.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15",
    "node-addon-api": "7.1.1",
    "react-router": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.2.0",
    "playwright-core": "1.63.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "storybook": "8.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "7.2.6"
  },
  "overrides": {
    "yauzl": "3.3.1",
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "2.1.3"
    }
  },
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
