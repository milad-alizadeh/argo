{
  "name": "@argo/desktop",
  "version": "0.1.0",
  "description": "Argo cockpit on Electron. Scaffold under migration; packaged tests are its gate.",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/dev-instance.mjs",
    "dev:status": "node scripts/dev-control.mjs status",
    "dev:stop": "node scripts/dev-control.mjs stop",
    "dev:prove-isolation": "node scripts/prove-dev-instance-isolation.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook-dark --project=storybook-light",
    "design:render": "node scripts/render-desktop-state.mjs",
    "build": "bun run test:packaged-pty --arch arm64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:packaged-contents": "node scripts/assert-packaged-pty.mjs",
    "test:packaged-manifest": "bun run desktop:manifest",
    "test:darwin-manifest": "electron-forge package --platform darwin --arch arm64 && node scripts/desktop-manifest.mjs out/Argo-darwin-arm64/Argo.app",
    "test:packaged-pty": "node scripts/prove-packaged-pty.mjs",
    "test:e2e": "playwright test",
    "test:journey-profile": "ARGO_JOURNEY_PROFILE=1 playwright test --project=sessions e2e/sessions/journeys.e2e.ts",
    "e2e:real": "ARGO_E2E_REAL=1 playwright test --project=real-sessions",
    "test:live-claude-display": "bun build tools/claude/message-display.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=out/tools/message-display.mjs && node out/tools/message-display.mjs",
    "capture:cockpit": "bun build tools/cockpit/capture.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=out/tools/capture-cockpit.mjs && node out/tools/capture-cockpit.mjs",
    "measure:cockpit": "bun build tools/cockpit/measure.ts --target=node --format=esm --packages=external --external=playwright-core --external=chromium-bidi --outfile=out/tools/measure-cockpit.mjs && node out/tools/measure-cockpit.mjs",
    "desktop:manifest": "node scripts/desktop-manifest.mjs",
    "desktop:verdict": "node scripts/write-release-verdict.mjs",
    "test": "bun test",
    "test:feed": "bun test src/core/sessions src/agents/claude/sessions src/agents/claude/integration src/agents/codex/sessions mocks/sessions src/renderer/modules/sessions/feed"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "node-addon-api": "7.1.1",
    "node-pty": "1.2.0-beta.15",
    "react-day-picker": "^10.0.1",
    "recharts": "^3.8.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@lexical/code": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@playwright/test": "^1.63.0",
    "@shadcn/react": "0.3.1",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron": "44.2.0",
    "i18next": "^26.4.2",
    "lexical": "^0.39.0",
    "lucide-react": "1.44.0",
    "mermaid": "12.0.0",
    "msw": "^2",
    "playwright-core": "1.63.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-i18next": "^17.0.13",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "react-router": "^7.13.1",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vitest": "^4.0.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "yauzl": "3.3.1",
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "2.1.3"
    }
  },
  "trustedDependencies": [
    "node-pty",
    "electron"
  ]
}
