{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/mocks/*": ["./mocks/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // The e2e flows serialize browser closures through Playwright, and their assertions execute
    // against the packaged app, so the strict node and web projects typecheck application code.
    "noCheck": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["e2e/**/*.ts"]
}
