{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // The proof drivers serialize browser closures through Playwright. Their assertions execute
    // against packaged runtime fixtures, so Bun builds them while the strict node and web
    // projects typecheck application code and shared contracts.
    "noCheck": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/core/projects/fake-driver/**/*.ts",
    "src/core/tickets/fake-driver/**/*.ts",
    "src/providers/github/fake-driver/**/*.ts",
    "src/core/sessions/fake-driver/**/*.ts",
    "src/agents/claude/session-fake-driver/**/*.ts",
    "src/agents/codex/session-fake-driver/**/*.ts",
    "src/core/appearance/**/*.test.ts",
    "src/core/projects/**/*.test.ts",
    "src/core/commands/**/*.test.ts"
  ]
}
