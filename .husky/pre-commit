# --- session isolation: AGENT commits belong in worktrees (see AGENTS.md "Session isolation") ---
# Concurrent agent sessions share this checkout; a commit here lands on whatever branch/index
# another session is using. Worktrees pass (git-dir != git-common-dir). Humans pass too —
# only agent sessions are blocked (CLAUDECODE marks Claude Code; harnesses with no env marker
# are governed by AGENTS.md). Agent override for a deliberate main-checkout commit
# (e.g. skills-lock.json after a reinstall): ARGO_MAIN_COMMIT=1 git commit ...
if [ -n "$CLAUDECODE" ] && [ -z "$ARGO_MAIN_COMMIT" ] \
   && [ "$(git rev-parse --git-dir 2>/dev/null)" = "$(git rev-parse --git-common-dir 2>/dev/null)" ]; then
  echo "pre-commit: blocked — this is the shared main checkout; implement in a worktree" >&2
  echo "  (git worktree add / EnterWorktree; override: ARGO_MAIN_COMMIT=1 git commit ...)" >&2
  exit 1
fi
# --- end session isolation ---

bunx lint-staged

# --- quality gates: the caps lint can't express (installed by setup-quality-gates) ---
# Per-file caps are biome's, and lint-staged already ran it over the staged files
# (style/noExcessiveLinesPerFile carries the 150-line ceiling; exemptions in biome.jsonc).
#
# The three PLACEMENT gates used to run here and no longer do: they read a
# `<workspace>/scripts/module-boundaries.json` module map, and retiring the Electron cockpit
# left this repo with no workspace that declares one. The scripts stay in `scripts/` — they
# are what `scaffold.mjs --hooks` ships to consumers, and what a future TypeScript workspace
# would wire back into `quality`. `scripts/placement-guard.mjs` is unaffected: it finds its
# map by walking ancestors, so with none present it simply permits, here and in a consumer
# alike. ADR-0021's rule is dormant, not withdrawn.
# --- end quality gates ---

# --- graphify: committed knowledge graph, refreshed in-commit (installed by setup-graphify) ---
# Refresh + stage the graph INTO this commit, but ONLY in the main working tree — linked
# worktrees are skipped (git-dir != git-common-dir), so feature branches never churn or
# conflict the graph. `graphify update` names every community deterministically from its
# dominant node — no LLM, no key, no churn. Never run `graphify label` here: it re-clusters
# and drops dated backup dirs. No-op until the graph exists.
if command -v graphify >/dev/null 2>&1 && [ -f graphify-out/graph.json ] \
   && [ "$(git rev-parse --git-dir 2>/dev/null)" = "$(git rev-parse --git-common-dir 2>/dev/null)" ]; then
  graphify update . >/dev/null 2>&1 || true
  git add graphify-out >/dev/null 2>&1 || true
fi
# --- end graphify ---
