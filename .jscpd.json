{
  "threshold": 1,
  "minTokens": 50,
  "minLines": 5,
  "format": ["typescript", "tsx", "javascript", "swift"],
  "reporters": ["console"],
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/.vite/**",
    "apps/desktop/scripts/prove-project-contract.mjs",
    "apps/desktop/scripts/prove-session-feed.mjs",
    "**/*.stories.tsx",
    "prototypes/**",
    "**/skills/**/templates/**",
    "**/build/**",
    "**/Fixtures/**",
    "**/Sources/ArgoFixtures/**"
  ]
}
