{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // Xcode owns the JSON inside `.xcodeproj` and `.xcassets` and rewrites it on every
    // edit — formatting it here would just trade one churn for another.
    //
    // KIND — the companion plugin's `Plugin/` resources are TEMPLATES, not documents: they
    // carry `__ARGO_*__` placeholders that the spawn substitutes, and one of them stands where
    // a number goes, which is not JSON until it is written out.
    //
    // KIND — `ArgoFixtures/Fixtures` is written by `argo-synthesise` and read by a test. Its
    // shape file is a RECORD of what the fixture beside it holds, so formatting it here would
    // put every regeneration one whitespace edit away from a red build for a document nobody
    // reads by hand.
    "includes": [
      "**",
      "!docs",
      "!**/*.xcodeproj",
      "!**/*.xcassets",
      "!**/ArgoEngine/Companion/Plugin",
      "!**/ArgoFixtures/Fixtures",
      // The Session proof drivers are TypeScript source. Bun writes these two runnable bundles
      // for Forge and CI, so formatting or linting the output would report copied implementation
      // code instead of the source module that owns it.
      "!apps/desktop/scripts/session-fake-driver/prove-project-contract.mjs",
      "!apps/desktop/scripts/session-fake-driver/prove-session-feed.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "style": {
        // The 150-line per-file ceiling (rules/house.md). Counts LINES OF CODE:
        // blank lines are skipped by the option, and comment lines are not counted by the
        // rule at all — a heavily-commented file is judged on the code you must hold in
        // your head, not on how far it scrolls. That is a statement about this linter, not
        // a comment budget; rules/house.md sets that.
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 150,
            "skipBlankLines": true
          }
        },
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "noUselessElse": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  // Cap exemptions. Two kinds, and the difference matters — see AGENTS.md "Quality gates".
  //   KIND    — the house rule exempts this category outright. Permanent.
  //   RATCHET — real code over a cap today. Debt. This list may only ever shrink;
  //             never add an entry to make a build pass.
  "overrides": [
    // KIND: throwaway research prototypes (output of the `prototype` skill). Deliberately
    // quick, deleted rather than maintained — the caps would tax exploration for no return.
    {
      "includes": ["prototypes/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off",
            "useMaxParams": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          // A prototype's whole question can be the element this rule tells you to replace:
          // #1754 weighs a contenteditable against a textarea, and the rule answers it by fiat.
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    // RATCHET: over the function-length or complexity cap when the gates landed. Each needs
    // extraction, none is a quick fix. Split the file, then delete its line here.
    {
      "includes": [
        // Cross-CLI hook projection: one branchy function over the harness matrix.
        "packages/argo-skills/bin/hooks-sync.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    // KIND: declarative catalogs the line ceiling does not apply to. A story is a named
    // state, not logic, so length here is coverage and the repetition between stories is the
    // point. No workspace writes stories today — the rule is the
    // category's, and it stands ready rather than being re-argued when one does.
    {
      "includes": ["**/*.stories.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    // The renderer boundary, and the one override here that is a security line rather than a
    // cap. `src/preload.ts` says it: "The renderer never gets Node. It gets one narrow, named
    // surface." Nothing enforced that, so a renderer file could import `electron` or a Node
    // built-in and still pass every gate — and #1763 turns on the renderer never holding a
    // token. The preload and the main process are deliberately NOT in scope: importing
    // `electron` is their job.
    //
    // Type-only imports count. Biome's rule reads `import type` too, which matters because
    // compilation erases it and a type-only reach across this boundary would otherwise be
    // invisible.
    {
      "includes": ["apps/desktop/src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "The renderer never imports electron. Expose a named surface from src/preload.ts and read it off window.",
                  "node-pty": "A PTY belongs to the main process. The renderer talks to it over the preload bridge."
                },
                // Four groups, because the bare names above are only the spelling a first draft
                // reaches for. A glob `*` does not cross a `/` in biome, so the subpath forms need
                // saying separately: `node:fs/promises` is the modern spelling of the exact thing
                // this rule exists to refuse, and `electron/renderer` is the documented entry a
                // developer reaching for `ipcRenderer` writes first. The unprefixed built-ins are
                // listed because `useNodejsImportProtocol`, which would otherwise normalise them
                // into the `node:` form this rule sees, is `info` severity and its fix is unsafe —
                // so `import cp from 'child_process'` survives both CI and lint-staged untouched.
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"]
                  },
                  {
                    "group": ["electron/**", "node-pty/**"]
                  },
                  {
                    "group": ["@electron/remote", "@electron/remote/**", "electron-store"]
                  },
                  {
                    "group": [
                      "assert",
                      "buffer",
                      "child_process",
                      "cluster",
                      "crypto",
                      "dgram",
                      "dns",
                      "fs",
                      "fs/**",
                      "http",
                      "http2",
                      "https",
                      "inspector",
                      "module",
                      "net",
                      "os",
                      "path",
                      "perf_hooks",
                      "process",
                      "readline",
                      "repl",
                      "stream",
                      "stream/**",
                      "timers",
                      "timers/**",
                      "tls",
                      "tty",
                      "util",
                      "v8",
                      "vm",
                      "worker_threads",
                      "zlib"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    // KIND: repo tooling reads the ambient environment by design (CI vars, git env, TTY).
    {
      "includes": ["scripts/**", "hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ]
}
