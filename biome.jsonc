{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // Xcode owns the JSON inside `.xcodeproj` and `.xcassets` and rewrites it on every
    // edit — formatting it here would just trade one churn for another.
    //
    // KIND — the companion plugin's `Plugin/` resources are TEMPLATES, not documents: they
    // carry `__ARGO_*__` placeholders that the spawn substitutes, and one of them stands where
    // a number goes, which is not JSON until it is written out.
    //
    // KIND — `ArgoFixtures/Fixtures` is written by `argo-synthesise` and read by a test. Its
    // shape file is a RECORD of what the fixture beside it holds, so formatting it here would
    // put every regeneration one whitespace edit away from a red build for a document nobody
    // reads by hand.
    "includes": [
      "**",
      "!docs",
      "!lint/biome/fixtures",
      "!apps/desktop/package-manifest.json",
      "!apps/desktop/src/platform/renderer/components/ui/accordion.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/alert-dialog.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/alert.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/aspect-ratio.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/attachment.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/avatar.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/badge.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/breadcrumb.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/bubble.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/button-group.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/button.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/calendar.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/card.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/carousel.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/chart.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/checkbox.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/collapsible.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/combobox.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/command.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/context-menu.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/dialog.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/direction.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/drawer.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/dropdown-menu.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/empty.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/field.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/hover-card.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/input-group.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/input-otp.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/input.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/item.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/kbd.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/label.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/marker.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/menubar.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/message-scroller.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/message.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/native-select.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/navigation-menu.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/pagination.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/popover.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/progress.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/questionnaire.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/radio-group.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/resizable.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/scroll-area.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/select.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/separator.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/sheet.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/sidebar.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/skeleton.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/slider.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/spinner.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/switch.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/table.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/tabs.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/textarea.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/toast.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/toggle-group.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/toggle.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/tooltip.tsx",
      "!apps/desktop/src/platform/renderer/components/ui/use-mobile.ts",
      "!**/*.xcodeproj",
      "!**/*.xcassets",
      "!**/ArgoEngine/Companion/Plugin",
      "!**/ArgoFixtures/Fixtures",
      // KIND — this records a generated package inventory. The manifest gate compares it byte for
      // byte with the package, so formatting and linting it do not provide a useful code check.
      "!apps/desktop/package-manifest.json",
      "apps/desktop/src/platform/renderer/components/ui/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "style": {
        // 300 is Biome's own default for this rule. Counts LINES OF CODE: blank lines are
        // skipped by the option, and biome 2.5.4 counts no comment line at all, wherever it
        // sits. Measured 2026-09-22, because the docs are silent and the rule's PR declined
        // ESLint's skipComments option. A commented file is judged on the code you hold in
        // your head, not on how far it scrolls.
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300,
            "skipBlankLines": true
          }
        },
        // Every file name is kebab-case, the convention the shadcn generator writes.
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        },
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "noUselessElse": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  // Cap exemptions. Two kinds, and the difference matters — see AGENTS.md "Quality gates".
  //   KIND    — the house rule exempts this category outright. Permanent.
  //   RATCHET — real code over a cap today. Debt. This list may only ever shrink;
  //             never add an entry to make a build pass.
  "overrides": [
    {
      "includes": [
        "apps/desktop/src/domains/projects/main/**/*.ts",
        "apps/desktop/src/domains/tickets/main/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:sqlite": "Normal durable repositories use the shared Drizzle adapter."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/components.json", "lint/biome/fixtures/components/**/*.json"],
      "plugins": ["./lint/biome/components-style.grit"]
    },
    {
      // A `.mjs` file is generated, not written (#2503). The two named files predate that rule
      // and run outside this repo's TypeScript projects, so Node still needs them untyped.
      "includes": [
        "**/*.mjs",
        "!packages/argo-skills/skills/setup-quality-gates/templates/file-length-check.mjs",
        "!docs/research/2026-09-09-mcp-instructions-proof.mjs"
      ],
      "plugins": ["./lint/biome/no-new-mjs.grit"]
    },
    {
      // #2624: this block's noRestrictedImports below is silently dropped for any file also
      // matched by a later overlapping override, because `overrides` does not merge one rule's
      // config across blocks — the last match wins whole. Unfixed; read the issue before adding
      // another override under this path.
      "includes": ["apps/desktop/src/platform/renderer/components/ui/**"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "preset": "none",
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "useExhaustiveDependencies": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noNestedTernary": "off",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "radix-ui",
                      "radix-ui/**",
                      "react-aria-components",
                      "react-aria-components/**"
                    ],
                    "message": "components.json uses base-nova. UI primitives must come from @base-ui/react."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/**/*.{ts,tsx}",
        "!apps/desktop/src/platform/renderer/components/ui/**",
        "!**/*.{test,stories}.{ts,tsx}",
        "!**/*-samples.{ts,tsx}",
        "!apps/desktop/src/platform/shared/appearance.ts"
      ],
      "plugins": ["./lint/biome/design-values-js.grit", "./lint/biome/i18n.grit"]
    },
    {
      "includes": ["apps/desktop/src/**/*.css", "!**/tokens.css"],
      "plugins": ["./lint/biome/design-values-css.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/domains/*/contract/**",
        "apps/desktop/src/platform/shared/**",
        "apps/desktop/src/shared/**",
        "!**/*.{test,stories}.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "Contract and shared code stay runtime-neutral.",
                  "node-pty": "Contract and shared code stay runtime-neutral.",
                  "react": "Contract and shared code stay free of React."
                },
                "patterns": [
                  {
                    "group": ["../*", "./*/*"],
                    "message": "./ imports stay in the current directory. Use @/ for parent or cross-directory source imports."
                  },
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "Contract and shared code stay runtime-neutral."
                  },
                  {
                    "group": [
                      "@/domains/*/main",
                      "@/domains/*/main/**",
                      "@/domains/*/preload",
                      "@/domains/*/preload/**",
                      "@/domains/*/renderer",
                      "@/domains/*/renderer/**",
                      "@/platform/main",
                      "@/platform/main/**",
                      "@/platform/preload",
                      "@/platform/preload/**",
                      "@/platform/renderer",
                      "@/platform/renderer/**",
                      "@/providers",
                      "@/providers/**",
                      "@/renderer",
                      "@/renderer/**",
                      "@/core",
                      "@/core/**"
                    ],
                    "message": "Contract and shared code can import only contract or shared facets."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/domains/*/main/**",
        "apps/desktop/src/platform/main/**",
        "!**/*.{test,stories}.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "./*/*"],
                    "message": "./ imports stay in the current directory. Use @/ for parent or cross-directory source imports."
                  },
                  {
                    "group": [
                      "@/domains/*/preload",
                      "@/domains/*/preload/**",
                      "@/domains/*/renderer",
                      "@/domains/*/renderer/**",
                      "@/platform/preload",
                      "@/platform/preload/**",
                      "@/platform/renderer",
                      "@/platform/renderer/**"
                    ],
                    "message": "Main facets can import only contract, main, or shared facets."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/test-fixtures/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "./*/*"],
                    "message": "Test fixtures use @/ for parent or cross-directory source imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/domains/*/preload/**",
        "apps/desktop/src/platform/preload/**",
        "!**/*.{test,stories}.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "./*/*"],
                    "message": "./ imports stay in the current directory. Use @/ for parent or cross-directory source imports."
                  },
                  {
                    "group": [
                      "@/domains/*/main",
                      "@/domains/*/main/**",
                      "@/domains/*/renderer",
                      "@/domains/*/renderer/**",
                      "@/platform/main",
                      "@/platform/main/**",
                      "@/platform/renderer",
                      "@/platform/renderer/**"
                    ],
                    "message": "Preload facets can import only contract, preload, or shared facets."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/domains/*/renderer/**",
        "apps/desktop/src/platform/renderer/**",
        "apps/desktop/src/renderer/**",
        "!**/*.{test,stories}.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "Renderer facets use the preload bridge instead of Electron directly.",
                  "node-pty": "Renderer facets use the preload bridge instead of Node directly."
                },
                "patterns": [
                  {
                    "group": ["../*", "./*/*"],
                    "message": "./ imports stay in the current directory. Use @/ for parent or cross-directory source imports."
                  },
                  {
                    "group": ["node:*", "node:*/**", "electron/**", "node-pty/**"],
                    "message": "Renderer facets use the preload bridge instead of runtime-only APIs."
                  },
                  {
                    "group": [
                      "@/domains/*/main",
                      "@/domains/*/main/**",
                      "@/domains/*/preload",
                      "@/domains/*/preload/**",
                      "@/platform/main",
                      "@/platform/main/**",
                      "@/platform/preload",
                      "@/platform/preload/**",
                      "@/providers",
                      "@/providers/**",
                      "@/core",
                      "@/core/**"
                    ],
                    "message": "Renderer facets can import only contract, renderer, or shared facets."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/harnesses/**",
        "!**/*.{test,stories}.{ts,tsx}",
        "!**/session-fixtures.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "./*/*"],
                    "message": "./ imports stay in the current directory. Use @/ for parent or cross-directory source imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // KIND: throwaway research prototypes (output of the `prototype` skill). Deliberately
    // quick, deleted rather than maintained — the caps would tax exploration for no return.
    {
      "includes": ["prototypes/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off",
            "useMaxParams": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useFilenamingConvention": "off"
          },
          // A prototype's whole question can be the element this rule tells you to replace:
          // #1754 weighs a contenteditable against a textarea, and the rule answers it by fiat.
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    // RATCHET: over the function-length or complexity cap when the gates landed. Each needs
    // extraction, none is a quick fix. Split the file, then delete its line here.
    {
      "includes": [
        // Cross-CLI hook projection: one branchy function over the harness matrix.
        "packages/argo-skills/bin/hooks-sync.mts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    // KIND: a Playwright fixture reads the fixtures it depends on off the literal destructuring
    // pattern in its first parameter (#2325, #2326): Playwright's own docs write one that needs
    // none as `async ({}, use) => {`, and a named parameter in its place breaks that reading
    // rather than just going unused.
    {
      "includes": [
        "apps/desktop/e2e/packaged-proof.ts",
        "apps/desktop/e2e/sessions/session-proof-run.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    // KIND: declarative catalogs the line ceiling does not apply to. A story is a named
    // state, not logic, so length here is coverage and the repetition between stories is the
    // point. No workspace writes stories today — the rule is the
    // category's, and it stands ready rather than being re-argued when one does.
    {
      "includes": ["**/*.stories.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    // KIND: a state machine is one declarative transition graph. Splitting that graph to
    // satisfy a file ceiling hides its states, transitions and invoked actors from readers.
    {
      "includes": ["**/*-machine.ts"],
      "formatter": {
        "expand": "always"
      },
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    // KIND: the token contract is one declarative catalog. Splitting it would hide ownership
    // across files, so its length is not a measure of code complexity.
    {
      "includes": ["apps/desktop/src/platform/renderer/tokens.css"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    // KIND: the icon vocabulary is one declarative catalog, one semantic name per lucide glyph.
    // Splitting it would hide the mapping the house rule ("one new file plus one registration
    // line") asks a reader to see in one place.
    {
      "includes": ["apps/desktop/src/platform/renderer/components/icon-registry.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    // The renderer boundary, and the one override here that is a security line rather than a
    // cap. `src/preload.ts` says it: "The renderer never gets Node. It gets one narrow, named
    // surface." Nothing enforced that, so a renderer file could import `electron` or a Node
    // built-in and still pass every gate — and #1763 turns on the renderer never holding a
    // token. The preload and the main process are deliberately NOT in scope: importing
    // `electron` is their job.
    //
    // Type-only imports count. Biome's rule reads `import type` too, which matters because
    // compilation erases it and a type-only reach across this boundary would otherwise be
    // invisible.
    {
      "includes": [
        "apps/desktop/src/domains/*/renderer/**",
        "apps/desktop/src/platform/renderer/**",
        "apps/desktop/src/renderer/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "The renderer never imports electron. Expose a named surface from src/preload.ts and read it off window.",
                  "node-pty": "A PTY belongs to the main process. The renderer talks to it over the preload bridge."
                },
                // Four groups, because the bare names above are only the spelling a first draft
                // reaches for. A glob `*` does not cross a `/` in biome, so the subpath forms need
                // saying separately: `node:fs/promises` is the modern spelling of the exact thing
                // this rule exists to refuse, and `electron/renderer` is the documented entry a
                // developer reaching for `ipcRenderer` writes first. The unprefixed built-ins are
                // listed because `useNodejsImportProtocol`, which would otherwise normalise them
                // into the `node:` form this rule sees, is `info` severity and its fix is unsafe —
                // so `import cp from 'child_process'` reaches CI untouched.
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"]
                  },
                  {
                    "group": ["electron/**", "node-pty/**"]
                  },
                  {
                    "group": ["@electron/remote", "@electron/remote/**", "electron-store"]
                  },
                  {
                    "group": [
                      "assert",
                      "buffer",
                      "child_process",
                      "cluster",
                      "crypto",
                      "dgram",
                      "dns",
                      "fs",
                      "fs/**",
                      "http",
                      "http2",
                      "https",
                      "inspector",
                      "module",
                      "net",
                      "os",
                      "path",
                      "perf_hooks",
                      "process",
                      "readline",
                      "repl",
                      "stream",
                      "stream/**",
                      "timers",
                      "timers/**",
                      "tls",
                      "tty",
                      "util",
                      "v8",
                      "vm",
                      "worker_threads",
                      "zlib"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    // KIND: repo tooling reads the ambient environment by design (CI vars, git env, TTY).
    {
      "includes": ["scripts/**", "packages/argo-skills/skills/setup-argo-skills/hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ]
}
