{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version", "package.json", "turbo.json"],
  "globalPassThroughEnv": [
    "OPENAI_API_KEY",
    "REALTIME_MODEL",
    "ARGO_LIVE_CLI",
    "ARGO_DESKTOP_DEV_PORT"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/*.stories.tsx",
        "index.html",
        "public/**",
        "assets/**",
        "forge.config.ts",
        "vite.*.config.ts",
        "tsconfig.json",
        "tsconfig.node.json",
        "tsconfig.web.json",
        "scripts/assert-packaged-pty.mts",
        "scripts/packaged-pty-checks.mts",
        "scripts/entitlements.mts",
        "scripts/fuse-profile.mts",
        "scripts/production-install.mts",
        "package.json",
        "package-lock.json",
        "$TURBO_ROOT$/bun.lock"
      ],
      "env": ["ARGO_SIGNING_*", "ARGO_NOTARIZE_*"],
      "outputs": ["out/Argo-darwin-arm64/**"]
    },
    "test:packaged-contents": {
      "dependsOn": ["build"],
      "inputs": [
        "scripts/assert-packaged-pty.mts",
        "scripts/packaged-pty-checks.mts",
        "scripts/packaged-mock-cli-checks.mts",
        "scripts/packaged-app.mts",
        "scripts/acceptance-protocol.mts",
        "mocks/cli/mock-cli-process-titles.mts",
        "package-lock.json"
      ],
      "outputs": []
    },
    "test:packaged-manifest": {
      "dependsOn": ["build"],
      "inputs": [
        "scripts/desktop-manifest.mts",
        "scripts/package-manifest.mts",
        "scripts/packaged-pty-checks.mts",
        "package-manifest.json",
        "package-lock.json"
      ],
      "outputs": []
    },
    "test:packaged-pty": {
      "dependsOn": ["build"],
      "inputs": [
        "scripts/prove-packaged-pty.mts",
        "scripts/packaged-app.mts",
        "scripts/acceptance-protocol.mts"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "e2e/**",
        "mocks/**",
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/*.stories.tsx",
        "scripts/acceptance-protocol.mts",
        "scripts/fuse-profile.mts",
        "playwright.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "env": ["CI", "ARGO_SESSION_SHOTS"],
      "outputs": []
    },
    "test:e2e:adversarial": {
      "dependsOn": ["build"],
      "inputs": [
        "e2e/**",
        "mocks/**",
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/*.stories.tsx",
        "scripts/acceptance-protocol.mts",
        "scripts/fuse-profile.mts",
        "playwright.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "env": ["CI", "ARGO_SESSION_SHOTS"],
      "outputs": []
    },
    "build:storybook": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        ".storybook/**/*.ts",
        "scripts/**/*.mts",
        "*.config.ts",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/scripts/design-token-*.mts"
      ],
      "outputs": []
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!*.md",
        "$TURBO_ROOT$/docs/design/tokens.css",
        "$TURBO_ROOT$/scripts/design-token-*.mts"
      ],
      "outputs": []
    },
    "test:feed": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md"],
      "outputs": []
    },
    "test:storybook": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md"],
      "outputs": []
    },
    "test:darwin-manifest": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "$TURBO_ROOT$/package-lock.json"],
      "env": ["ARGO_SIGNING_*", "ARGO_NOTARIZE_*"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
