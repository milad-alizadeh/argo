{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version", "package.json", "turbo.json"],
  "globalPassThroughEnv": [
    "OPENAI_API_KEY",
    "REALTIME_MODEL",
    "ARGO_LIVE_CLI",
    "ARGO_DESKTOP_DEV_PORT"
  ],
  "tasks": {
    "build": {
      "cache": false,
      "outputs": ["out/**"]
    },
    "build:storybook": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        ".storybook/**/*.ts",
        "scripts/**/*.mjs",
        "*.config.ts",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/scripts/design-token-*.mjs"
      ],
      "outputs": []
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!*.md",
        "$TURBO_ROOT$/docs/design/tokens.css",
        "$TURBO_ROOT$/scripts/design-token-*.mjs"
      ],
      "outputs": []
    },
    "test:feed": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md"],
      "outputs": []
    },
    "test:storybook": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md"],
      "outputs": []
    },
    "test:darwin-manifest": {
      "inputs": ["$TURBO_DEFAULT$", "!*.md", "$TURBO_ROOT$/package-lock.json"],
      "env": ["ARGO_SIGNING_*", "ARGO_NOTARIZE_*"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
