{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["OPENAI_API_KEY", "REALTIME_MODEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false
    },
    "screenshot": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
