{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "OPENAI_API_KEY",
    "REALTIME_MODEL",
    "ARGO_LIVE_CLI",
    "ARGO_GATE_CALLER",
    "ARGO_GATE_PHASE",
    "ARGO_REQUIRE_SWIFT_TOOLS",
    "ARGO_TEST_SCOPE",
    "ARGO_BUILD_LOCK_HELD_BY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ARGO_BUILD_CONFIGURATION"],
      "outputs": ["dist/**", "out/**"]
    },
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["ARGO_TEST_CONFIGURATION"]
    },
    "test:e2e": {
      "cache": false
    },
    "screenshot": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
