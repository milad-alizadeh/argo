node_modules/
# bun.lock is the root lockfile; apps/desktop/package-lock.json is the packaging one.
/package-lock.json
.turbo/
dist/
apps/desktop/storybook-static/
apps/desktop/coverage/
docs/designs/renders/
*.log
.DS_Store

# Xcode / SwiftPM build products and per-user editor state (apps/macOS).
# The shared scheme under xcshareddata IS committed — xcodebuild needs it.
DerivedData/
apps/macOS/build/
# screenshot output (scripts/screenshot.sh) — evidence for a PR, never committed to a branch
apps/macOS/out/
.build/
.swiftpm/
xcuserdata/
# sourcekit-lsp build server config — absolute DerivedData paths, per-machine.
# Regenerate: cd apps/macOS && xcode-build-server config -scheme Argo -project Argo.xcodeproj
apps/macOS/buildServer.json

# Installed skills (.agents/skills/, .claude/skills/) are committed so every worktree has them;
# skills-lock.json records them (packages/argo-skills/README.md).
# Shared project config (settings.json, output-styles) is real source — allowlisted;
# settings.local.json stays personal and ignored.
.claude/*
!.claude/settings.json
!.claude/output-styles/
!.claude/skills/
# Skills for harnesses this repo does not install for.
.cursor/skills/
.codex/skills/
.rtk/.rtk

# A real transcript, for the local figure recording over the largest Session (ADR-0030). The
# repository is public and a transcript is somebody's own words, so the whole directory is
# ignored rather than one name — what is committed is the synthetic of it, under
# apps/macOS/Packages/ArgoUI/Sources/ArgoFixtures/Fixtures.
apps/macOS/Fixtures/
