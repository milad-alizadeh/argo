node_modules/
.turbo/
dist/
*.log
.DS_Store

# Xcode / SwiftPM build products and per-user editor state (apps/macOS).
# The shared scheme under xcshareddata IS committed — xcodebuild needs it.
DerivedData/
apps/macOS/build/
# screenshot output (scripts/screenshot.sh) — evidence for a PR, never committed to a branch
apps/macOS/out/
.build/
.swiftpm/
xcuserdata/
# sourcekit-lsp build server config — absolute DerivedData paths, per-machine.
# Regenerate: cd apps/macOS && xcode-build-server config -scheme Argo -project Argo.xcodeproj
apps/macOS/buildServer.json

# Installed skill copies are throwaway outputs of `npx skills add` —
# skills-lock.json is committed and restores them via `npx skills experimental_install`.
# Shared project config (settings.json, output-styles) is real source — allowlisted;
# settings.local.json stays personal and ignored.
.agents/
.claude/*
!.claude/settings.json
!.claude/output-styles/
# Agent skills, installed by argo-skills
.claude/skills/
.agents/skills/
.cursor/skills/
.codex/skills/
.rtk/.rtk
