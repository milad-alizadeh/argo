{
  "name": "argo",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.4.2",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.4.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "jscpd": "^5.0.12",
    "knip": "6.37.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.3",
  "overrides": {
    "yauzl": "3.3.1"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build test:packaged-pty --filter=@argo/desktop",
    "build:storybook": "turbo run build:storybook",
    "dev": "turbo run dev",
    "desktop:status": "bun run --cwd apps/desktop dev:status",
    "desktop:stop": "bun run --cwd apps/desktop dev:stop",
    "format-and-lint": "biome check . --error-on-warnings",
    "format-and-lint:fix": "biome check . --write",
    "hooks:sync": "node packages/argo-skills/bin/hooks-sync.mts",
    "install:electron": "node node_modules/electron/install.js",
    "quality": "bun run format-and-lint && bun run test:quality-ratchet && bun run quality:types && bun run quality:duplication && bun run quality:boundaries && bun run quality:dead-code",
    "quality:baseline:remove-resolved": "node scripts/quality/migration-ratchet.mts remove-resolved",
    "quality:boundaries": "node scripts/quality/migration-ratchet.mts check boundaries",
    "quality:boundaries:raw": "node scripts/quality/migration-ratchet.mts raw boundaries",
    "quality:dead-code": "knip --no-progress --max-issues 601",
    "quality:duplication": "jscpd --config .jscpd.json --baseline-from-ref origin/main --fail-on-new-clones=0 apps packages scripts",
    "quality:raw": "bun run format-and-lint; argo_format_status=$?; bun run test:quality-ratchet; argo_ratchet_test_status=$?; bun run quality:types:raw; argo_types_status=$?; bun run quality:duplication; argo_duplication_status=$?; bun run quality:boundaries:raw; argo_boundaries_status=$?; bun run quality:dead-code; argo_dead_code_status=$?; test \"$argo_format_status\" -eq 0 -a \"$argo_ratchet_test_status\" -eq 0 -a \"$argo_types_status\" -eq 0 -a \"$argo_duplication_status\" -eq 0 -a \"$argo_boundaries_status\" -eq 0 -a \"$argo_dead_code_status\" -eq 0",
    "quality:types": "node scripts/quality/migration-ratchet.mts check types",
    "quality:types:raw": "node scripts/quality/migration-ratchet.mts raw types",
    "storybook": "turbo run storybook",
    "test": "node scripts/quality/migration-ratchet.mts check tests",
    "test:raw": "node scripts/quality/migration-ratchet.mts raw tests",
    "test:storybook": "node scripts/quality/migration-ratchet.mts check storybook",
    "test:storybook:raw": "node scripts/quality/migration-ratchet.mts raw storybook",
    "test:codex-transport": "node --test prototypes/codex-transport/channel.test.ts",
    "test:hooks": "node --test 'packages/argo-skills/skills/setup-argo-skills/hooks/*.test.mts'",
    "test:quality-ratchet": "node --test scripts/quality/migration-ratchet.test.mts",
    "typecheck:codex-transport": "tsc --noEmit -p prototypes/codex-transport/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "worktrees:gc": "sh packages/argo-skills/skills/setup-argo-skills/hooks/worktree-gc.sh",
    "worktrees:sweep": "sh packages/argo-skills/skills/setup-argo-skills/hooks/worktree-gc.sh --artifacts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "fs-xattr",
    "macos-alias",
    "node-pty"
  ],
  "dependencies": {
    "ansi-to-react": "^6.2.6",
    "shiki": "^4.4.3"
  }
}
