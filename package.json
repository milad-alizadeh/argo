{
  "name": "argo",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "lint-staged": "^17.1.0",
    "turbo": "^2.3.3"
  },
  "bin": {
    "argo": "packages/argo-skills/bin/scaffold.mjs"
  },
  "packageManager": "bun@1.3.3",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "format-and-lint": "biome check . --error-on-warnings",
    "format-and-lint:fix": "biome check . --write",
    "preinstall": "node scripts/node-version-gate.mjs",
    "install:electron": "node scripts/node-version-gate.mjs && node node_modules/electron/install.js",
    "quality": "bun run quality:node && bun run format-and-lint && bun run quality:types && bun run quality:duplication",
    "quality:node": "node scripts/node-version-gate.mjs",
    "quality:duplication": "jscpd --config .jscpd.json apps packages scripts",
    "quality:types": "turbo run typecheck",
    "test": "turbo run test",
    "test:hooks": "node scripts/run-suites.mjs",
    "contract:sweep": "node scripts/contract-readers.mjs",
    "worktrees:gc": "sh scripts/worktree-gc.sh",
    "worktrees:sweep": "sh scripts/worktree-gc.sh --artifacts",
    "load:orphans": "sh scripts/load-burst.sh --orphans",
    "hooks:sync": "node packages/argo-skills/bin/hooks-sync.mjs",
    "scaffold": "node packages/argo-skills/bin/scaffold.mjs",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "fs-xattr",
    "macos-alias",
    "node-pty"
  ]
}
