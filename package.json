{
  "name": "argo",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.4.2",
    "@types/node": "24.13.3",
    "bun-types": "^1.4.2",
    "dependency-cruiser": "18.4.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "jscpd": "^5.0.12",
    "knip": "6.37.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.3",
  "overrides": {
    "yauzl": "3.3.1"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build test:packaged-pty --filter=@argo/desktop",
    "build:storybook": "turbo run build:storybook",
    "dev": "turbo run dev",
    "desktop:status": "bun run --cwd apps/desktop dev:status",
    "desktop:stop": "bun run --cwd apps/desktop dev:stop",
    "format-and-lint": "biome check . --error-on-warnings",
    "format-and-lint:fix": "biome check . --write",
    "install:electron": "node node_modules/electron/install.js",
    "quality": "bun run format-and-lint && bun run quality:types && bun run quality:duplication && bun run quality:boundaries && bun run quality:dead-code",
    "quality:boundaries": "depcruise --config .dependency-cruiser.json apps/desktop/src apps/desktop/mocks apps/desktop/e2e",
    "quality:dead-code": "knip --no-progress --max-issues 0",
    "quality:duplication": "jscpd --config .jscpd.json apps packages scripts",
    "quality:types": "turbo run typecheck && bun run typecheck:codex-transport && bun run typecheck:scripts",
    "storybook": "turbo run storybook",
    "test": "turbo run test && bun run test:codex-transport",
    "test:storybook": "turbo run test:storybook --filter=@argo/desktop",
    "test:codex-transport": "node --test prototypes/codex-transport/channel.test.ts",
    "typecheck:codex-transport": "tsc --noEmit -p prototypes/codex-transport/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "fs-xattr",
    "macos-alias",
    "node-pty"
  ],
  "dependencies": {
    "anser": "2.3.5",
    "escape-carriage": "1.3.1",
    "shiki": "^4.4.3"
  }
}
