{
  "name": "argo",
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "24.13.3",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "lint-staged": "^17.1.0",
    "turbo": "^2.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.3",
  "overrides": {
    "yauzl": "3.3.1"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "design:tokens": "node scripts/design-token-mirror.mjs",
    "format-and-lint": "biome check . --error-on-warnings",
    "format-and-lint:fix": "biome check . --write",
    "hooks:sync": "node packages/argo-skills/bin/hooks-sync.mjs",
    "install:electron": "node scripts/node-version-gate.mjs && node node_modules/electron/install.js",
    "preinstall": "node scripts/node-version-gate.mjs",
    "prepare": "husky",
    "quality": "bun run quality:node && bun run format-and-lint && bun run quality:types && bun run quality:duplication && bun run quality:components",
    "quality:components": "node apps/desktop/scripts/check-component-base.mjs",
    "quality:duplication": "jscpd --config .jscpd.json apps packages scripts hooks",
    "quality:node": "node scripts/node-version-gate.mjs",
    "quality:types": "turbo run typecheck && bun run typecheck:codex-transport",
    "release:build": "turbo run release:build --filter=@argo/desktop",
    "test": "turbo run test && bun run test:codex-transport",
    "test:codex-transport": "node --test prototypes/codex-transport/channel.test.ts",
    "test:hooks": "node --test 'hooks/*.test.mjs'",
    "typecheck:codex-transport": "tsc --noEmit -p prototypes/codex-transport/tsconfig.json",
    "worktrees:gc": "sh hooks/worktree-gc.sh",
    "worktrees:sweep": "sh hooks/worktree-gc.sh --artifacts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "electron",
    "esbuild",
    "fs-xattr",
    "macos-alias",
    "node-pty"
  ]
}
